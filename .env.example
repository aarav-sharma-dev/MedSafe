# MedSafe optional environment configuration
# Copy this file to `.env` if you want to enable optional Gemini plain-language
# explanations and translations. MedSafe works completely without an API key.

# Optional: free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: override the Gemini model name (defaults to gemini-3.8-flash)
MEDSAFE_GEMINI_MODEL=gemini-3.8-flash

# Optional: network timeouts in seconds
MEDSAFE_HTTP_TIMEOUT=8
MEDSAFE_AI_TIMEOUT=25


# Optional: free openFDA API key from https://open.fda.gov/apis/authentication/
# Without a key openFDA allows 1,000 requests/day per IP; with a key 120,000/day.
# (Both allow 240 requests/minute.) MedSafe works without it.
OPENFDA_API_KEY=
